{
  "manifest_version": 3,
  "name": "StopNBlock",
  "version": "1.0.0",
  "description": "Stop and request block of YouTube ads.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://adsettings.google.com/*",
    "*://adssettings.google.com/*",
    "*://myadcenter.google.com/*"
  ],
  "action": {
    "default_title": "Stop and block this ad"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "trigger-stop-block": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "MacCtrl+Shift+Q"
      },
      "description": "Stop and request block of current ad"
    }
  }
}
